{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"*.json",
			"packages/**/*.json",
			"apps/backend/**/*.json",
			"apps/frontend/**/*.json",
			"packages/**/*.ts",
			"packages/**/*.tsx",
			"apps/backend/**/*.ts",
			"apps/frontend/**/*.ts",
			"apps/frontend/**/*.tsx",
			"!!apps/frontend/bundle-report",
			"apps/frontend/src/routeTree.gen.ts",
			"apps/frontend/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noStaticOnlyClass": "off"
			},
			"correctness": {
				"noChildrenProp": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		},
		"domains": {
			"react": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
