# ── Staging Environment ─────────────────────────
# Copy this file to .env.staging and fill in your
# Neon branch values (see docs/staging-workflow.md)
# ────────────────────────────────────────────────

# Database — point to a Neon branch (not production)
DB_HOST=ep-your-branch.us-east-2.aws.neon.tech
DB_PORT=5432
DB_USER=your-neon-user
DB_PASSWORD=your-neon-password
DB_NAME=credets_db
DB_TLS=true

# Encryption — use the SAME keys as production
# (you're testing the app, not the encryption)
ENC_KEY=your-64-char-hex-key
CSRF_SECRET_KEY=your-csrf-secret

# Server
PORT=8000
NODE_ENV=development

# CORS — allow local frontend
FRONTEND_APP=http://localhost:3000
