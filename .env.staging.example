POSTGRES_URL=neon-db-connection-string-here

# Database — point to a Neon branch (not production)
DB_HOST=ep-your-branch.us-east-2.aws.neon.tech
DB_PORT=5432
DB_USER=your-neon-user
DB_PASSWORD=your-neon-password
DB_NAME=credets_db
DB_TLS=true

# Encryption — i donno why but use the SAME keys as production. lol
ENC_KEY=prod-key
CSRF_SECRET_KEY=prod-key

NODE_ENV=production

# CORS — allow local frontend
FRONTEND_APP=http://localhost:3000
BACKEND_APP=http://localhost:8000
# backend port
PORT=8000

# minio. we will use minio and not supabase storage credentials when staging
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=credentials
MINIO_USENAME=minioadmin // need for first time login only, when try to view webui
MINIO_PASSWORD=minioadmin // need for login only, when try to view webui
