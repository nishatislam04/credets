# Git
.git
.gitignore

# Environment files — not needed in production image
.env*
.env
.env.*.local

# Docs — not needed at runtime
docs/
README.md
*.md

# Frontend — not used by backend Docker image
apps/frontend/*
!apps/frontend/package.json

# Node modules — will be installed fresh in Docker
node_modules

# OS files
.DS_Store

# Cache and temp
.turbo
.tanstack
.nitro
.wrangler
.output
.vinxi
__unconfig*
