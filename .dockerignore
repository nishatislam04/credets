# ── Version control ──
.git
.gitignore

# ── Environment & secrets ──
.env
.env.*

# ── Dependencies ──
# Already installed inside the Docker image via bun install
node_modules

# ── OS artifacts ──
.DS_Store
Thumbs.db

# ── Documentation ──
# Not needed at runtime
*.md
docs/

# ── Agent/IDE configs ──
.agents/
.cta.json

# ── Frontend source (not needed in this Dockerfile) ──
# These aren't copied by the Dockerfile, but excluding them from the build
# context reduces the payload sent to the Docker daemon, speeding up builds.
apps/frontend/node_modules
apps/frontend/dist
apps/frontend/src/
apps/frontend/public/
apps/frontend/.env
apps/frontend/index.html
apps/frontend/vite.config.ts
apps/frontend/tsconfig.json
apps/frontend/components.json
apps/frontend/biome.json
apps/frontend/skills-lock.json
apps/frontend/.agents/
apps/frontend/.cta.json
