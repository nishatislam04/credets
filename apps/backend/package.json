{
	"name": "@credets/backend",
	"version": "1.0.0",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --watch --no-clear-screen --console-depth 10 index.ts",
		"dev:staging": "bun --env-file=../.env.staging run --watch --no-clear-screen --console-depth 10 index.ts",
		"debug": "PORT=8001 bun run --watch --no-clear-screen --console-depth 10 index.ts",
		"start": "bun index.ts",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"date-fns": "^4.1.0",
		"zod": "^4.4.3",
		"@aws-sdk/client-s3": "^3.1063.0",
		"@credets/shared-schema": "workspace:*"
	},
	"devDependencies": {
		"@credets/shared-types": "workspace:*",
		"@credets/shared-utils": "workspace:*",
		"typescript": "catalog:"
	}
}
