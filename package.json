{
	"name": "credets",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently --names \"BACK,FRONT\" --prefix-colors \"green,pink\" \"bun run dev:backend\" \"bun run dev:frontend\"",
		"dev:backend": "bun --filter @credets/backend dev",
		"dev:frontend": "bun --filter @credets/frontend dev",
		"build:frontend": "bun --filter @credets/frontend build",
		"build:frontend:staging": "bun --filter @credets/frontend build --mode staging",
		"preview:frontend:staging": "bun --filter @credets/frontend staging",
		"start:backend:staging": "bun --filter @credets/backend staging",
		"staging": "bun run build:frontend:staging && concurrently --names \"MINIO,FRONT,BACK,REPORT\" --prefix-colors \"blue,pink,green,yellow\" \"podman-compose -f podman-compose.staging.yml up\" \"bun run preview:frontend:staging\" \"bun run start:backend:staging\" \"cd apps/frontend && bunx vite-bundle-explorer bundle-report\"",
		"seed": "bun run apps/backend/db/seed.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@types/bun": "latest",
		"concurrently": "^10.0.3",
		"@types/node": "^26.1.1"
	},
	"catalog": {
		"zod": "^4.4.3",
		"typescript": "^7.0.2"
	}
}
