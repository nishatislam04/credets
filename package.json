{
	"name": "credets",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently --names \"BACK,FRONT\" --prefix-colors \"green,pink\" \"bun run dev:backend\" \"bun run dev:frontend\"",
		"dev:backend": "bun run --cwd apps/backend dev",
		"dev:backend:staging": "bun run --cwd apps/backend dev:staging",
		"dev:frontend": "bun run --cwd apps/frontend dev",
		"seed": "bun run apps/backend/db/seed.ts",
		"sync-context": "bun run utils/sync-context.ts",
		"sync-context:check": "bun run utils/sync-context.ts --check",
		"build:frontend": "bun run --cwd apps/frontend build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@types/bun": "latest",
		"@types/node": "^25.9.1",
		"concurrently": "^9.2.1"
	},
	"catalog": {
		"zod": "^4.4.3",
		"typescript": "^6.0.2"
	}
}
